# ── Garbanzo publishing credentials (all optional) ─────────────────────────
# Without these, the pipeline runs in DEMO MODE: same flow, simulated
# delivery, but Instagram cards are still rendered for real.
#
# Every post can travel two routes (set per platform below):
#   direct  → the platform's own API (default)
#   buffer  → through your Buffer account (one key, many networks)

# ═══ Direct APIs ════════════════════════════════════════════════════════════

# Instagram (Meta Graph API — Business/Creator accounts only)
# developers.facebook.com → app (Business) → Instagram Graph API →
# long-lived token with instagram_basic + instagram_content_publish.
# Find your IG user id: GET graph.facebook.com/v24.0/me/instagram_business_account
#INSTAGRAM_ACCESS_TOKEN=IGQVJ...
#INSTAGRAM_IG_USER_ID=1784...
#GRAPH_API_VERSION=v24.0

# X (Twitter) API v2
# developer.x.com → your app → OAuth 2.0 → USER-context token
# (scopes: tweet.read, tweet.write). App-only bearer tokens cannot post.
# Entry tier is quota-limited (~50 posts/day) — check current tiers at developer.x.com.
#X_ACCESS_TOKEN=...

# LinkedIn REST API v2 — needs the "Share on LinkedIn" (w_member_social) product
# linkedin.com/developers → create app → add product → OAuth 2.0 → token
#LINKEDIN_ACCESS_TOKEN=AQXa...
#LINKEDIN_URN=urn:li:person:abc123   # optional; auto-resolved from the token

# ═══ Buffer (second option — one key, many networks) ═══════════════════════
# buffer.com account → publish.buffer.com → Settings → API → Generate API key
# Connect your social accounts inside Buffer first (free plan: 3 channels).
# Rate limit: 100 requests / 15 min. Media must be public URLs.
#BUFFER_API_KEY=...
# Optional: pin channel ids per platform (else auto-resolved by network name)
#BUFFER_CHANNEL_INSTAGRAM=
#BUFFER_CHANNEL_TWITTER=
#BUFFER_CHANNEL_FACEBOOK=
#BUFFER_CHANNEL_LINKEDIN=
#BUFFER_CHANNEL_TIKTOK=

# ═══ Route selection (per platform) ════════════════════════════════════════
# Switch any platform to Buffer as its second option:
#PUBLISH_VIA_INSTAGRAM=buffer
#PUBLISH_VIA_TWITTER=buffer
#PUBLISH_VIA_FACEBOOK=buffer
#PUBLISH_VIA_LINKEDIN=buffer
#PUBLISH_VIA_TIKTOK=buffer

# ═══ Public URL of this app ════════════════════════════════════════════════
# Lets Instagram/Buffer fetch the rendered card by URL (else Instagram falls
# back to a binary upload). The preview host works, e.g.:
#PUBLIC_URL=https://3000-your-sandbox.e2b.app
